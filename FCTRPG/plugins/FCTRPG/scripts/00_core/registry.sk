# ============================================================
# FCTRPG :: 00_core/registry.sk
# Central data-driven registries (Constitution #69, #68).
# Adding races/classes/lines/materials/etc. should mean adding
# data here, NOT rewriting unrelated systems.
#
# Registry entry format:  "key|field1|field2|..."
# Parsed once at load into {fctrpg::reg::<type>::<key>::*}.
# ============================================================

options:
    # Schema version of the persistent state (Constitution #75).
    db-version: 1

# ------------------------------------------------------------
# RACE REGISTRY
# Format: key|display|statBudget|forgePoints|traitKey|notes
# Traits reference 30_mechanics/racial_traits.sk handlers.
# ------------------------------------------------------------
function fctrpg_registry_races() :: list of strings:
    return:
        - "human|Human|10|12|adaptability|Balanced baseline; bonus to a single focused discipline"
        - "dwarrow|Dwarrow|12|10|stoneblood|Dense frame: slower movement, +damage vs constructs/undead, forge affinity"
        - "sylvan|Sylvan|9|13|wildshape|Bond with creatures; daylight regen; weaker in deep realms"
        - "draconic|Draconic|11|11|drakeheart|High power ceiling, low durability floor; fire resonance"
        - "giant|Giant|13|8|colossus|Reach and raw force; precision penalty; slow"
        - "fae|Fae|8|14|faewild|Reality-bending magic affinity; iron weakness; bargain synergy"
        - "revenant|Revenant|10|12|undeath|Death-adjacent mechanics; negative faction reactions; no food need"
        - "beastkin|Beastkin|10|12|feral_senses|Enhanced senses/tracking; Beast synergy; armor comfort penalty"
        - "elemental|Elemental|9|13|elementbody|Elemental damage/resistance swings; environment-dependent power"
        - "voidborn|Voidborn|9|13|voidtouched|High risk/reward; corruption accumulation; space distortions"
        - "mycelian|Mycelian|9|13|sporebound|Decay alchemy synergy; sunlight fragility; regrowth healing"
        - "seraphic|Seraphic|10|12|radiance|Healing/light magic; fall mechanic toward hidden line"
        - "deepborn|Deepborn|11|11|abyssal|Pressure/water domain; surface weakness; Deep realm affinity"
        - "mimic|Mimic|8|15|shapeshift|Item-disguise utility; identity instability debuff"
        - "chimeric|Chimeric|9|14|chimera|Borrows traits of other races via rare materials; instability cost"

# ------------------------------------------------------------
# CLASS REGISTRY
# Format: key|display|primaryResource|combatStyleTag|archetypePhrase
# ------------------------------------------------------------
function fctrpg_registry_classes() :: list of strings:
    return:
        - "mage|Mage|essence|spellcaster|Manipulation of magical forces"
        - "warrior|Warrior|momentum|melee|Force, momentum, commitment"
        - "archer|Archer|focus|ranged|Distance, trajectories, weak points"
        - "rogue|Rogue|opportunity|stealth|Positioning, deception, exploitation"
        - "beast|Beast|bond|petmaster|Living creature relationships"
        - "summoner|Summoner|geass|summoner|Manifestation of supernatural entities"
        - "elementbound|Elementbound|attunement|elemental|Deep relationships with elemental forces"
        - "artificer|Artificer|charges|engineering|Devices, mechanisms, engineered solutions"
        - "warden|Warden|authority|controller|Territory, boundaries, battlefield states"
        - "seeker|Seeker|insight|explorer|Discovery, investigation, tracking"
        - "alchemist|Alchemist|reagent|transformer|Reactions, materials, volatile combinations"
        - "psion|Psion|psi|mind|Perception, focus, sensory manipulation"
        - "reaver|Reaver|sacrifice|riskdamager|Sacrifice, risk, disproportionate power"
        - "shaper|Shaper|structure|terrain|Matter, structure, terrain alteration"
        - "binder|Binder|contract|debuffer|Contracts, conditions, rules"
        - "harbinger|Harbinger|omen|delayedeffects|Omens, prediction, changing future states"

# ------------------------------------------------------------
# LINE REGISTRY (initial vertical slice; grows per Constitution #14)
# Format: classKey|lineKey|display|identitySentence
# A line must change HOW the class's mechanical language is used.
# ------------------------------------------------------------
function fctrpg_registry_lines() :: list of strings:
    return:
        - "mage|pyromancer|Pyromancer|Burns essence to stack Scorch; damage scales with enemy burn; punishes stationary fights"
        - "mage|cryomancer|Cryomancer|Builds Chill on self and foes; slow is a resource; positioning is the game"
        - "mage|stormcaller|Stormcaller|Overcharge gambles: each cast may refund or detonate stored charge; weather interacts"
        - "mage|voidweaver|Voidweaver|Trades max essence now for later payoff; corruption economy"
        - "mage|abjurer|Abjurer|Converts incoming damage into essence; wins by being hit intelligently"
        - "warrior|vanguard|Vanguard|Momentum builds by advancing; abilities only fire above momentum thresholds"
        - "warrior|berserker|Berserker|Spends health as a resource; power inversely tied to survival margin"
        - "warrior|shieldbreaker|Shieldbreaker|Shatters guards/blocking; bonus language vs defended enemies"
        - "archer|marksman|Marksman|Weak-point shots after Scout reveals them; setup-heavy burst"
        - "archer|volley_master|Volley Master|Ammo count matters; suppressive patterns control space"
        - "rogue|assassin|Assassin|Opportunity spent on flank/backstab executions"
        - "rogue|trickster|Trickster|Opportunity generated by deceiving AI targeting"
        - "seeker|cartographer|Cartographer|Mapping unknown chunks grants permanent party buffs and lore leads"
        - "seeker|relic_hunter|Relic Hunter|Appraisal crits; finds hidden dungeon secrets others cannot see"

# ------------------------------------------------------------
# RESOURCE REGISTRY (Constitution #23)
# Format: key|display|maxTag|generationTag|spendTag
# Essence is the UNIVERSAL resource shared across all classes.
# ------------------------------------------------------------
function fctrpg_registry_resources() :: list of strings:
    return:
        - "essence|Essence|base_100_plus_vitality|universal_slow_tick|universal_spellfloor"
        - "momentum|Momentum|cap_100|melee_hits_taken_dealt|decays_out_of_combat"
        - "focus|Focus|cap_tied_precision|stationary_ticks|reset_by_movement"
        - "opportunity|Opportunity|cap_5|flank_backstab_stealth_events|consumed_per_execute"
        - "bond|Bond|cap_tied_pet_quality|pet_actions_proximity|shared_damage_sharing"
        - "geass|Geass|cap_tied_summons|summon_upkeep_events|overdraft_corruption_risk"
        - "attunement|Attunement|env_dependent|environmental_elements|resets_with_biome"
        - "charges|Charges|cap_tied_devices|device_builds_repair|spent_on_activations"
        - "authority|Authority|zone_control_based|holding_ground|lost_on_yield"
        - "insight|Insight|discovery_based|new_chunks_first_kills_loot|spent_on_reveals"
        - "reagent|Reagent|material_stock_based|mining_herb_craft|consumed_real_items"
        - "psi|Psi|cap_tied_will|concentration_ticks|breaks_on_damage"
        - "sacrifice|Sacrifice|hp_conversion|self_damage|banked_burst"
        - "structure|Structure|terrain_reading|altering_terrain|spent_on_forms"
        - "contract|Contract|binding_events|promises_fulfilled|breach_punishment"
        - "omen|Omen|forecast_events|delayed_casts|cashout_timing_game"

# ------------------------------------------------------------
# PROFESSION REGISTRY (Constitution #33)
# Format: key|display|axisTag
# ------------------------------------------------------------
