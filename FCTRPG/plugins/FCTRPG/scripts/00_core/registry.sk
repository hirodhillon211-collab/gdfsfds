        - "blacksmith|Blacksmith|forging"
        - "alchemist_prof|Alchemist|transmutation"
        - "merchant|Merchant|economy"
        - "hunter|Hunter|tracking"
        - "cartographer_prof|Cartographer|exploration"
        - "scholar|Scholar|research"
        - "engineer|Engineer|magitech"
        - "beast_specialist|Beast Specialist|creatures"
        - "relic_researcher|Relic Researcher|relics"

# ------------------------------------------------------------
# MATERIAL REGISTRY (Constitution #30 — properties, not tiers)
# Format: key|display|density|flexibility|conductivity|heatres|resonance|toxicity|stability|affinity
# Property values 0..10. Forging outcomes read these vectors.
# ------------------------------------------------------------
function fctrpg_registry_materials() :: list of strings:
    return:
        - "iron|Iron|7|3|5|6|1|0|8|none"
        - "steel|Steel|8|4|4|7|1|0|9|none"
        - "mithral|Mithral|5|7|9|5|8|1|6|arcane"
        - "orichalcum|Orichalcum|9|2|8|9|9|3|4|elemental"
        - "shadowglass|Shadowglass|3|1|10|2|10|5|2|void"
        - "heartwood|Heartwood|2|8|2|2|6|0|7|life"
        - "frostiron|Frostiron|7|2|6|1|5|0|8|ice"
        - "embersteel|Embersteel|8|3|5|10|4|2|5|fire"
        - "boneporcelain|Bone Porcelain|4|2|1|4|7|2|5|death"
        - "sporehide|Sporehide|3|9|2|1|4|6|3|decay"
        - "voidite|Voidite|6|0|10|3|10|8|1|void"
        - "sunsilver|Sun Silver|5|6|9|6|9|0|7|light"

# ------------------------------------------------------------
# REALM REGISTRY (Constitution #52) — placeholders until Phase 13
# Format: key|display|hazardTag|drawPhrase
# ------------------------------------------------------------
function fctrpg_registry_realms() :: list of strings:
    return:
        - "the_verdant_mark|The Verdant Mark|none|Starting region; Sylvan presence; moderate zone"
        - "ashfall_reaches|Ashfall Reaches|burning_ground|Rare fire materials; Draconic remnants; dangerous region"
        - "the_deep_coil|The Deep Coil|pressure_dark|Deepborn territory; submerged ruins; dangerous region"
        - "hollow_expanse|Hollow Expanse|corruption_fields|Voidborn anomalies; unstable magic; dangerous region"

# ------------------------------------------------------------
# DAMAGE TYPE / ENEMY TYPE MATRIX (Constitution #26)
# Format: attackerType|targetType|multiplier
# This table drives combat multipliers. Extend with data only.
# ------------------------------------------------------------
function fctrpg_registry_typematrix() :: list of strings:
    return:
        - "fire|plant|2.0"
        - "fire|beast|1.5"
        - "fire|construct|0.5"
        - "ice|elemental|1.5"
        - "ice|beast|1.2"
        - "shock|construct|1.5"
        - "shock|waterborne|1.8"
        - "void|undead|1.5"
        - "void|living|0.8"
        - "holy|undead|2.0"
        - "holy|voidspawn|1.5"
        - "slashing|plant|1.3"
        - "piercing|armored|1.4"
        - "bludgeoning|armored|1.2"
        - "bludgeoning|undead|1.3"

# ------------------------------------------------------------
# LOAD / PARSE — builds authoritative lookup tables (Constitution #68)
# ------------------------------------------------------------
on load:
    loop fctrpg_registry_races():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::race::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_classes():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::class::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_lines():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::line::%{_p[1]}%::%{_p[2]}%::*} to {_p::*}
    loop fctrpg_registry_resources():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::resource::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_professions():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::profession::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_materials():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::material::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_realms():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::realm::%{_p[1]}%::*} to {_p::*}
    loop fctrpg_registry_typematrix():
        set {_p::*} to split loop-value at "|"
        set {fctrpg::reg::typemul::%{_p[1]}%::%{_p[2]}%} to ({_p[3]} as number)
    # Material acquisition seeds (Const. #31 chain: Exploration ->
    # Materials). One authoritative ore mapping per material key.
    # Display name carries the material key for unambiguous lookup.
    loop fctrpg_registry_materials():
        set {_p::*} to split loop-value at "|"
        set {_ore} to raw iron named "&bOre of %{_p[2]}%" with lore "&8FCTRPG material&7 • forge stock", "&kMAT:&f%{_p[1]}%"
        set {fctrpg::reg::material::%{_p[1]}%::oreitem} to {_ore}
    set {fctrpg::reg::ready} to true
    send "&8[FCTRPG] &7Registries loaded: %size of fctrpg_registry_races()% races, %size of fctrpg_registry_classes()% classes, %size of fctrpg_registry_lines()% lines." to console

# ------------------------------------------------------------
# GENERIC LOOKUP HELPERS (Public API — Constitution #65)
# ------------------------------------------------------------
function fctrpg_reg(type: text, key: text, field: integer = 2) :: text:
    if arg(1) is "race":
        return {fctrpg::reg::race::%arg(2)%::%arg(3)%}
    else if arg(1) is "class":
        return {fctrpg::reg::class::%arg(2)%::%arg(3)%}
    else if arg(1) is "resource":
        return {fctrpg::reg::resource::%arg(2)%::%arg(3)%}
    else if arg(1) is "material":
        return {fctrpg::reg::material::%arg(2)%::%arg(3)%}
    else if arg(1) is "profession":
        return {fctrpg::reg::profession::%arg(2)%::%arg(3)%}
    else if arg(1) is "realm":
        return {fctrpg::reg::realm::%arg(2)%::%arg(3)%}
    else:
        return ""

function fctrpg_line_field(classKey: text, lineKey: text, field: integer = 3) :: text:
    return {fctrpg::reg::line::%arg(1)%::%arg(2)%::%arg(3)%}

function fctrpg_type_multiplier(atk: text, def: text) :: number:
    set {_m} to {fctrpg::reg::typemul::%arg(1)%::%arg(2)%}
    if {_m} is not set:
        return 1
    return {_m}

# Extracts first field (keys) from registry rows.
function fctrpg_keys_of(rows: list of strings) :: list of strings:
    loop arg(1):
        set {_p::*} to split loop-value at "|"
        add {_p[1]} to {_keys::*}
    return {_keys::*}
